# Backend server
SERVER_PORT=9000
SERVER_HOST=0.0.0.0

# Frontend API URL (for production, set to VPS public URL)
VITE_API_URL=http://localhost:9000
VITE_WS_URL=ws://localhost:9000/ws

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:9000

# VNC proxy port range start
VNC_PROXY_PORT_START=6081

# Device health check interval (ms)
HEALTH_CHECK_INTERVAL=15000

# Device HTTP API timeout (ms)
DEVICE_API_TIMEOUT=5000

# Screenshots directory
SCREENSHOTS_DIR=./server/data/screenshots

# JWT Secret (change in production)
JWT_SECRET=phoneclaw-secret-key-change-in-production

# Heartbeat monitoring
HEARTBEAT_URL=
HEARTBEAT_STALE_THRESHOLD=90000
STALENESS_CHECK_INTERVAL=30000

# OpenCV template matching
TEMPLATES_DIR=./server/data/templates
OPENCV_MATCH_TIMEOUT=10000

# ============================================================
# PostgreSQL Database
# ============================================================
# Connection string
DATABASE_URL=postgresql://phoneagent:your-password@localhost:5432/phoneagent

# Connection pool size (default: 20, suitable for VPS 8GB RAM)
DB_POOL_MAX=20

# Idle connection timeout (ms)
DB_POOL_IDLE_TIMEOUT=30000

# Feature flag: set to 'true' to use PostgreSQL, 'false' for JSON files
USE_POSTGRES=false
